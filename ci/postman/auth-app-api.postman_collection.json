{
  "info": {
    "_postman_id": "f1c313db-8f25-4b6c-9a9b-0f7c2d5a5a01",
    "name": "API de autenticacion - XAMPP",
    "description": "Exportacion para CI de la coleccion Postman del proyecto. Ejecuta las pruebas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Verificar API y base de datos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La API y MySQL responden', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().message).to.include('conectada');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "2. Registrar un usuario nuevo",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('testUser', 'postman_' + Date.now());",
              "pm.collectionVariables.set('testPassword', 'PostmanClave123');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El usuario queda registrado', function () {",
              "    pm.response.to.have.status(201);",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.eql('Usuario registrado correctamente.');",
              "    pm.expect(body.usuario.usuario).to.eql(pm.collectionVariables.get('testUser'));",
              "    pm.collectionVariables.set('testUserId', body.usuario.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{testUser}}\",\n  \"contrasena\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "response": []
    },
    {
      "name": "3. Iniciar sesion correctamente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{testUser}}\",\n  \"contrasena\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El inicio de sesion es correcto', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.eql('Inicio de sesion correcto.');",
              "    pm.expect(body.usuario.id).to.eql(Number(pm.collectionVariables.get('testUserId')));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "4. Rechazar contrasena incorrecta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{testUser}}\",\n  \"contrasena\": \"ContrasenaIncorrecta123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La clave incorrecta no permite el acceso', function () {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.json().message).to.include('usuario o contrasena incorrectos');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5. Rechazar usuario ya registrado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{testUser}}\",\n  \"contrasena\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('El usuario repetido devuelve un aviso claro', function () {",
              "    pm.response.to.have.status(409);",
              "    pm.expect(pm.response.json().message).to.eql('Ese usuario ya esta registrado.');",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "6. Rechazar datos invalidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"ab\",\n  \"contrasena\": \"corta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Los datos invalidos se explican al cliente', function () {",
              "    pm.response.to.have.status(400);",
              "    pm.expect(pm.response.json().message).to.include('Revisa los datos');",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "testUser",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserId",
      "value": "",
      "type": "string"
    }
  ]
}
